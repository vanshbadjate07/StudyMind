# Copy to .env and fill in for production. With none of the LLM provider
# keys below set, the app falls back to a local Ollama instance (local dev
# default) — see app/services/llm_client.py.

# Cloud LLM provider chain, tried in this order: Cerebras -> Groq -> Gemini.
# Only providers with at least one key set are used; the app keeps working
# with just one, but more give resilience against a single provider's daily
# limit or an outage. Each is a JSON array — one key is fine
# (["key1"]), multiple keys are tried in order before moving to the next
# provider, roughly multiplying that provider's daily quota. All three offer
# a free tier with no credit card required.
#   Cerebras: https://cloud.cerebras.ai        (~1M free tokens/day per key)
#   Groq:     https://console.groq.com          (~14.4k free requests/day per key)
#   Gemini:   https://aistudio.google.com/apikey (~1.5k free requests/day per key)
STUDYMIND_CEREBRAS_API_KEYS=[]
STUDYMIND_GROQ_API_KEYS=[]
STUDYMIND_GEMINI_API_KEYS=[]

# Comma-aware tuple in pydantic-settings — set to your deployed frontend's
# origin(s) in production; defaults to local Vite dev server only.
# STUDYMIND_CORS_ORIGINS=["https://your-frontend-domain.com"]

# Defaults to a local SQLite file under backend/data/ — fine through MVP1.
# STUDYMIND_DATABASE_URL=
